<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox (spec §9). A free Apple ID / ad-hoc signature is enough to run
	     this locally; Developer ID / notarization is only needed to distribute. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The two persisted folder grants (photo library, export target) — both need
	     write access: the live DB's VACUUM INTO snapshot and SD imports write into
	     the photo folder, exports write into the export folder. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Lets the security-scoped bookmarks created for those two folders keep
	     resolving across app launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
